<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SpendRadar" parent="android:Theme.Material.NoActionBar" />

    <style name="Theme.CustomSplashScreenTheme" parent="android:Theme.Material.NoActionBar">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.SpendRadar</item>
    </style>

    <style name="Theme.NoActionBar" parent="Theme.SpendRadar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>